        <mxCell id="5FUGML_ANkqW0i52DTNW-1" parent="1" style="shape=ext;double=1;rounded=0;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#FAE5C7;strokeColor=#0F8B8D;fontColor=#143642;" value="&lt;div&gt;Cobol CPB&lt;/div&gt;&lt;div&gt;für Satzarten&amp;nbsp;&lt;/div&gt;&lt;div&gt;10, 15, 20, 30&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;Copybooks&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;S37DN6[1235]K&lt;/span&gt;&lt;/div&gt;" vertex="1">
